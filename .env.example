# Copy to .env.local. Never commit actual credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=
# Set true only after confirming your intended use is allowed by your plan.
ELEVENLABS_USE_CONFIRMED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional instead of the three Cloudinary variables above:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Approved-team login and saved projects
MONGODB_URI=
MONGODB_DB=sochitra
BETTER_AUTH_URL=http://localhost:3001
# Random secret, at least 32 characters. Keep private.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated, exact Google account email addresses. Empty means deny everyone.
APPROVED_EMAILS=

# Local background jobs: run npm run workflow:dev alongside the app.
INNGEST_DEV=1
# For Vercel, omit INNGEST_DEV and configure these instead:
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
